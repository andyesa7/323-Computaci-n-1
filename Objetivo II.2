Algoritmo SumaParesImpares

Variables
    i, suma_pares, suma_impares : Entero

Inicio
    suma_pares <- 0
    suma_impares <- 0

    Para i <- 1 Hasta 200 Hacer
        Si (i MOD 2 = 0) Entonces
            suma_pares <- suma_pares + i
        Sino
            suma_impares <- suma_impares + i
        FinSi
    FinPara

    Escribir "Suma de números pares: ", suma_pares
    Escribir "Suma de números impares: ", suma_impares
Fin
